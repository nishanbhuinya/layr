    ],
    "tags": [
      "icons"
    ],
    "examples": "./examples"
  },
  "peerDependencies": {
    "@dynshift/layr": "^3.0.0-0"
  },
  "devDependencies": {
    "@dynshift/layr": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
