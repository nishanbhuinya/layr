import { GoogleFonts } from '@dynshift/layr-google-fonts'

// Colours are theme tokens (src/app.layr sets them for this gallery), so the page follows the
// reader's theme: light or dark here, and the site's theme on layr.dynshift.com.
Page(
  .name(Specimen)
  .route('/')

  Scaffold(
    .config(color: canvas)
    .body(
      Column(
        .config(
          w: fill
          gap: 28
          padding: all(32)
        )
        Column(
          .config(gap: 6)
          Text(
            .config(
              size: 13
              color: faint
              font: GoogleFonts.JetBrainsMono
            )
            .obj('Fraunces · 600')
          )
          Text(
            .config(
              size: 56
              color: ink
              font: GoogleFonts.Fraunces
              letterSpacing: -1.5
              lineHeight: 1
              weight: 600
            )
            .obj('Layout, authored.')
          )
        )
        Row(
          .config(
            w: fill
            gap: 24
            yAlign: stretch
          )
          Column(
            .config(
              w: fill
              color: sunken
              cornerRadius: 12
              gap: 8
              padding: all(20)
            )
            Text(
              .config(
                size: 13
                color: muted
                font: GoogleFonts.JetBrainsMono
              )
              .obj('Space Grotesk')
            )
            Text(
              .config(
                size: 26
                color: ink
                font: GoogleFonts.SpaceGrotesk
                weight: 500
              )
              .obj('Numbers flow, structure steps.')
            )
          )
          Column(
            .config(
              w: fill
              color: panel
              cornerRadius: 12
              gap: 8
              padding: all(20)
            )
            Text(
              .config(
                size: 13
                color: muted
                font: GoogleFonts.JetBrainsMono
              )
              .obj('Instrument Serif')
            )
            Text(
              .config(
                size: 30
                color: accent
                font: GoogleFonts.InstrumentSerif
              )
              .obj('One meaning per line.')
            )
          )
        )
      )
    )
  )
)
