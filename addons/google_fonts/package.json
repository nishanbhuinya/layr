{
  "name": "@dynshift/layr-google-fonts",
  "version": "3.0.0-next.0",
  "description": "Every Google Font as a LAYR font value: font: GoogleFonts.Fraunces loads the family on first use.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "layr",
    "layr-addon",
    "fonts",
    "google-fonts",
    "typography"
  ],
  "homepage": "https://layr.dynshift.com/library/google_fonts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishanbhuinya/layr.git",
    "directory": "addons/google_fonts"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "layr": {
    "id": "google_fonts",
    "kind": "utility",
    "layr": "^3.0.0-0",
    "categories": [
      "utilities",
      "typography"
    ],
    "tags": [
      "fonts",
      "google-fonts"
    ],
    "examples": "./examples"
  },
  "peerDependencies": {
    "@dynshift/layr": "^3.0.0-0"
  },
  "devDependencies": {
    "@dynshift/layr": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
