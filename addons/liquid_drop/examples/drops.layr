import { LiquidDrop } from '../src/index.layr'

Page(
  .name(Drops)
  .route('/')
  .meta(title: 'Liquid drop')
  Scaffold(
    .config(color: #0d0d0d)
    .body(Mid(Row(
      .config(gap: 48, yAlign: mid)
      LiquidDrop()
      LiquidDrop(.config(tint: #10b981, size: 120, label: 'LAYR'))
      LiquidDrop(.config(tint: #f43f5e, size: 90))
    )))
  )
)
