{
  "name": "@dynshift/layr-kit",
  "version": "3.0.0-next.0",
  "description": "LAYR Kit: styled buttons, cards, fields, badges, dialogs and navigation built on LAYR's accessible core widgets.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "layr",
    "layr-addon",
    "kit",
    "buttons",
    "cards"
  ],
  "homepage": "https://layr.dynshift.com/library/kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishanbhuinya/layr.git",
    "directory": "addons/kit"
  },
  "exports": {
    ".": "./src/index.layr",
    "./package.json": "./package.json"
  },
  "files": [
