// LAYR Kit: styled components on LAYR's accessible core widgets.
// Every widget takes a `tint`; defaults follow the kit's neutral palette.

Widget(
  .name(PrimaryButton)
  .param(
    req txt label
    color tint = #2563eb
    color ink = #ffffff
    bool disabled = false
  )
  var bool hover = false
  .obj(
    Button(
      .config(
        color: param.disabled ? param.tint.alpha(40%) : hover ? param.tint.shade(1) : param.tint
        cornerRadius: 10
        disabled: param.disabled
        padding: sym(x: 18, y: 10)
      )
      .on(hover: { hover = true }, hoverEnd: { hover = false })
      .obj(Text(.config(color: param.ink, weight: semibold, selectable: false) .obj(param.label)))
    )
  )
)

Widget(
  .name(SecondaryButton)
  .param(
    req txt label
    color tint = #0d0d0d
    bool disabled = false
  )
  var bool hover = false
  .obj(
    Button(
      .config(
        color: hover ? param.tint.alpha(6%) : transparent
        cornerRadius: 10
        disabled: param.disabled
        padding: sym(x: 18, y: 10)
        .border(color: param.tint.alpha(25%), width: 1)
      )
      .on(hover: { hover = true }, hoverEnd: { hover = false })
      .obj(Text(.config(color: param.tint, weight: semibold, selectable: false) .obj(param.label)))
    )
  )
)

Widget(
  .name(GhostButton)
  .param(req txt label, color tint = #2563eb)
  var bool hover = false
  .obj(
    Button(
      .config(color: hover ? param.tint.alpha(8%) : transparent, cornerRadius: 10, padding: sym(x: 14, y: 8))
      .on(hover: { hover = true }, hoverEnd: { hover = false })
      .obj(Text(.config(color: param.tint, weight: semibold, selectable: false) .obj(param.label)))
    )
  )
)

Widget(
  .name(Card)
  .param(
    txt title = ''
    txt subtitle = ''
    len pad = 20
    paint surface = #ffffff
  )
  .obj(
    Container(
      .config(
        w: fill
        color: param.surface
        cornerRadius: 16
        padding: all(param.pad)
        shadow: shadow(y: 1, blur: 3, color: black.alpha(8%))
        .border(color: #e7e5e4, width: 1)
      )
      .obj(Column(
        .config(w: fill, gap: 12)
        If(
          .cnd(param.title != '')
          .obj(Column(
            .config(gap: 2)
            Text(.config(type: h3, size: 18) .obj(param.title))
            If(.cnd(param.subtitle != '') .obj(Text(.config(size: 14, color: #6b6b6b) .obj(param.subtitle))))
          ))
        )
        .obj
      ))
    )
  )
)

Widget(
  .name(Badge)
  .param(req txt label, color tint = #2563eb)
  .obj(
    Container(
      .config(color: param.tint.alpha(12%), cornerRadius: 999, padding: sym(x: 10, y: 3))
      .obj(Text(.config(color: param.tint, size: 12, weight: semibold) .obj(param.label)))
    )
  )
)

Widget(
  .name(Chip)
  .param(req txt label, bool selected = false, color tint = #2563eb)
  .obj(
    Button(
      .config(
        color: param.selected ? param.tint : transparent
        cornerRadius: 999
        padding: sym(x: 14, y: 6)
        .border(color: param.selected ? param.tint : #d6d3d1, width: 1)
      )
      .a11y(pressed: param.selected)
      .obj(Text(.config(color: param.selected ? white : #0d0d0d, size: 14, selectable: false) .obj(param.label)))
    )
  )
)

Widget(
  .name(TextField)
  .param(
    req txt label
    txt value = ''
    txt placeholder = ''
    txt kind = 'text'
  )
  .obj(
    Input(
      .config(
        w: fill
        color: #ffffff
        cornerRadius: 10
        kind: param.kind
        label: param.label
        padding: sym(x: 12, y: 10)
        placeholder: param.placeholder
        value: param.value
        .border(color: #d6d3d1, width: 1)
      )
    )
  )
)

Widget(
  .name(Switch)
  .param(req txt label, bool value = false, color tint = #2563eb)
  .obj(
    Row(
      .config(gap: 10, yAlign: mid, cursor: pointer)
      .a11y(role: 'switch', checked: param.value, label: param.label)
      Animate(
        .eases(x: spring.snappy)
        .obj(Container(
          .config(w: 44, h: 26, color: param.value ? param.tint : #d6d3d1, cornerRadius: 13, padding: all(3), objAlign: param.value ? midRight : midLeft)
          .obj(Container(.config(size: 20, color: white, cornerRadius: 10, shadow: shadow(y: 1, blur: 2, color: black.alpha(25%)))))
        ))
      )
      Text(.config(selectable: false) .obj(param.label))
    )
  )
)

Widget(
  .name(Dialog)
  .param(bool open = false, txt title = '', txt closeLabel = 'Close')
  .obj(
    Overlay(
      .config(open: param.open, label: param.title, backdrop: black.alpha(40%))
      .obj(Container(
        .config(minW: 320, maxW: 560, color: white, cornerRadius: 20, padding: all(24), shadow: shadow(y: 12, blur: 40, color: black.alpha(25%)))
        .obj(Column(
          .config(w: fill, gap: 16)
          Row(
            .config(w: fill, xAlign: between, yAlign: mid)
            Text(.config(type: h2, size: 20) .obj(param.title))
            GhostButton(.config(label: param.closeLabel, tint: #0d0d0d) .fnc { emit('close') })
          )
          .obj
        ))
      ))
    )
  )
)

Widget(
  .name(NavBar)
  .param(txt title = '', paint surface = #ffffff)
  .obj(
    Row(
      .config(w: fill, color: param.surface, padding: sym(x: 24, y: 14), xAlign: between, yAlign: mid, .border(color: #e7e5e4, width: 1))
      Text(.config(weight: black, size: 18) .obj(param.title))
      Row(.config(gap: 20, yAlign: mid) .obj)
    )
  )
)

Widget(
  .name(Divider)
  .param(color tint = #e7e5e4)
  .obj(Container(.config(w: fill, h: 1px, color: param.tint)))
)

Widget(
  .name(Avatar)
  .param(req txt name, txt src = '', len size = 40)
  .obj(
    Clip(
      .config(shape: circle, size: param.size)
      .obj(If(
        .cnd(param.src != '')
        .obj(Image(.config(src: param.src, alt: param.name, size: param.size)))
        .fb(Container(
          .config(size: param.size, color: #e7e5e4, objAlign: mid)
          .obj(Text(.config(weight: semibold, color: #57534e) .obj(param.name.slice(0, 1).toUpperCase())))
        ))
      ))
    )
  )
)

Widget(
  .name(Callout)
  .param(req txt text, txt tone = 'info')
  .obj(
    Container(
      .config(
        w: fill
        color: param.tone == 'danger' ? #fef2f2 : param.tone == 'warning' ? #fffbeb : param.tone == 'success' ? #f0fdf4 : #eff6ff
        cornerRadius: 12
        padding: sym(x: 16, y: 12)
        .border(color: param.tone == 'danger' ? #fecaca : param.tone == 'warning' ? #fde68a : param.tone == 'success' ? #bbf7d0 : #bfdbfe, width: 1)
      )
      .obj(Text(.config(size: 15) .obj(param.text)))
    )
  )
)
