// {{Name}}: a LAYR addon widget. Params become config keys for its users.
Widget(
  .name({{Name}})
  .param(
    req txt label
    color tint = #3b82f6
  )
  .wgt(
    Container(
      .config(
        color: param.tint
        cornerRadius: 12
        padding: sym(x: 16, y: 10)
      )
      .obj(
        Text(
          .config(
            color: white
            weight: semibold
          )
          .obj(param.label)
        )
      )
    )
  )
)
