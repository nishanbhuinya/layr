// {{Name}}: a LAYR addon widget. Params become config keys for its users.
Widget(
  .name({{Name}})
  .param(
    req txt label
    color tint = #3b82f6
  )
  .obj(
    Container(
      .config(padding: sym(x: 16, y: 10), color: param.tint, cornerRadius: 12)
      .obj(Text(.config(color: white, weight: semibold) .obj(param.label)))
    )
  )
)
