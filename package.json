{
	"name": "layr-monorepo",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"description": "Monorepo for Layr - Flutter-inspired layout primitives for React",
	"scripts": {
		"build": "pnpm --filter @dynshift/layr build",
		"dev": "pnpm --filter @dynshift/layr dev",
		"test": "pnpm --filter @dynshift/layr test",
		"test:watch": "pnpm --filter @dynshift/layr test:watch",
		"lint": "pnpm --filter @dynshift/layr lint",
		"typecheck": "pnpm --filter @dynshift/layr typecheck",
		"clean": "pnpm --filter @dynshift/layr exec rm -rf dist",
		"prepublish": "pnpm build && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.2",
		"@types/react": "^18.3.12",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.0"
}
