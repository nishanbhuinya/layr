{
	"name": "@dynshift/layr",
	"version": "1.0.2",
	"description": "Flutter-inspired layout primitives for React",
	"keywords": [
		"react",
		"flutter",
		"layout",
		"components",
		"ui",
		"typescript",
		"container",
		"stack",
		"column",
		"row",
		"widgets",
		"layout-primitives"
	],
	"homepage": "https://layr.dynshift.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/nishanbhuinya/layr",
		"directory": "packages/layr"
	},
	"bugs": {
		"url": "https://github.com/nishanbhuinya/layr/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Nishan Bhuinya",
		"url": "https://nishanbhuinya.com"
	},
	"contributors": [
		{
			"name": "MNBLabs",
			"url": "https://github.com/MNBLabs"
		}
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@testing-library/react": "^16.1.0",
		"@types/react": "^18.3.12",
		"@vitejs/plugin-react": "^4.3.4",
		"jsdom": "^25.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
