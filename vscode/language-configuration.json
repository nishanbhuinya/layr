{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"], ["{", "}"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [["(", ")"], ["{", "}"], ["[", "]"], ["'", "'"], ["\"", "\""], ["`", "`"]],
  "indentationRules": { "increaseIndentPattern": "[({\\[]\\s*(//.*)?$", "decreaseIndentPattern": "^\\s*[)}\\]]" },
  "onEnterRules": [
    { "beforeText": "[({\\[]\\s*(//.*)?$", "afterText": "^\\s*[)}\\]]", "action": { "indent": "indentOutdent" } },
    { "beforeText": "^\\s*//.*$", "action": { "indent": "none" } }
  ],
  "folding": { "markers": { "start": "^\\s*//\\s*#?region\\b", "end": "^\\s*//\\s*#?endregion\\b" } },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
