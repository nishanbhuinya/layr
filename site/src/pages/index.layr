import { TopBar } from '../widgets/shell.layr'
import { SiteFooter } from '../widgets/footer.layr'
import { AddonRow, Band, Pane, PrimaryLink, SectionHead, TextLink } from '../widgets/home.layr'
import { loadHome } from '../lib/content.ts'
import { Ad } from '../react/Ad.tsx'
import { Cascade } from '../react/Cascade.tsx'
import { Frames } from '../react/Frames.tsx'
import { AiPanel } from '../react/AiPanel.tsx'
import { CodeField } from '../react/CodeField.tsx'
import { Studio } from '../react/Studio.tsx'
import { Code, Command, Console } from '../react/Prose.tsx'

Widget(
  .name(Tab)
  .param(
    req txt label
    bool on = false
  )
  .wgt(
    Button(
      .config(
        className: 'tab'
        color: param.on ? panel : transparent
        cornerRadius: 6
        padding: sym(x: 12, y: 8)
        .border(
          color: param.on ? line : transparent
          width: 1
        )
      )
      .a11y(pressed: param.on)
      .obj(
        Text(
          .config(
            size: 13
            color: param.on ? ink : muted
            weight: medium
          )
          .obj(param.label)
        )
      )
    )
  )
)

Page(
  .name(Home)
  .route('/')
  .meta(
    title: 'LAYR: build websites deterministically'
    description: 'LAYR is a compiled UI language. Write layout in design pixels and ship static CSS and React that resolve the same way on every screen.'
  )
  .load { return loadHome() }
  var txt tab = 'source'
  Scaffold(
    .config(color: canvas)
    .bar(TopBar())
    .body(
      Column(
        .config(w: fill)
        // The first viewport: the claim, one paragraph and two ways in, over this page's own source
        // glitching in the site's light; then a real LAYR page running live under an inspector.
        Stack(
          .config(w: fill)
          Container(
            .config(
              w: fill
              h: fill
              className: 'hero-ground'
            )
            .obj(
              If(
                .cnd(data != null)
                .obj(CodeField(.props(source: data.field)))
              )
            )
          )
          Column(
            .config(
              w: fill
              className: 'hero-content'
              gap: 56
              padding: only(left: 32, right: 32, top: 88, bottom: 64)
              xAlign: mid
            )
            .at(
              m
              padding: only(left: 16, right: 16, top: 48, bottom: 40)
              gap: 36
            )
            Column(
              .config(
                w: fill
                maxW: 880
                gap: 24
                xAlign: mid
              )
              Text(
                .config(
                  size: 13
                  className: 'hero-eyebrow'
                  color: muted
                  font: code
                  letterSpacing: 0.4
                  weight: medium
                )
                .obj('LAYR · Layout Authoritative Yet Responsive')
              )
              Text(
                .config(
                  size: 76
                  align: mid
                  className: 'hero-title'
                  letterSpacing: -3
                  lineHeight: 1
                  type: h1
                  weight: 660
                )
                .at(
                  m
                  size: 42
                  letterSpacing: -1.6
                  lineHeight: 1.04
                )
                .at(
                  t
                  size: 68
                  letterSpacing: -2.6
                )
                .obj('Build websites deterministically.')
              )
              Text(
                .config(
                  size: 19
                  maxW: 620
                  align: mid
                  color: muted
                  lineHeight: 1.55
                )
                .at(
                  m
                  size: 17
                )
                .obj(
                  'A compiled UI language. Write layout in your design’s numbers and ship static CSS and React that resolve the same way on every screen.'
                )
              )
              Wrap(
                .config(
                  gap: 12
                  margin: only(top: 8)
                  runGap: 12
                  xAlign: mid
                  yAlign: mid
                )
                PrimaryLink(
                  .config(
                    label: 'Try it in the browser'
                    href: '/playground'
                    icon: 'play'
                  )
                )
                Command(.props(command: 'npx @dynshift/layr create my-app'))
              )
            )
            Column(
              .config(
                w: fill
                maxW: 1240
              )
              If(
                .cnd(data != null)
                .obj(
                  Studio(
                    .props(
                      code: data.demo.code
                      codeHtml: data.demo.html
                      lines: data.demo.lines
                      file: data.demo.file
                      playground: data.demo.playground
                    )
                  )
                )
              )
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Layout you can read in the code.'
              sub: 'Objects nest the way they render. The compiler turns the file into static CSS and a React module, and both are yours to read.'
            )
          )
          If(
            .cnd(data != null)
            .obj(
              Pane(
                Row(
                  .config(
                    w: fill
                    color: sunken
                    gap: 4
                    padding: all(6)
                    .border(
                      color: line
                      width: 1
                      sides: bottom
                    )
                  )
                  Tab(
                    .config(
                      label: 'profile.layr'
                      on: tab == 'source'
                    )
                    .fnc { tab = 'source' }
                  )
                  Tab(
                    .config(
                      label: 'Compiled CSS'
                      on: tab == 'css'
                    )
                    .fnc { tab = 'css' }
                  )
                  Tab(
                    .config(
                      label: 'React module'
                      on: tab == 'js'
                    )
                    .fnc { tab = 'js' }
                  )
                )
                If(
                  .cnd(tab == 'source')
                  .obj(
                    Code(
                      .props(
                        html: data.shape.source
                        scroll: true
                      )
                    )
                  )
                )
                If(
                  .cnd(tab == 'css')
                  .obj(
                    Code(
                      .props(
                        html: data.shape.css
                        scroll: true
                      )
                    )
                  )
                )
                If(
                  .cnd(tab == 'js')
                  .obj(
                    Code(
                      .props(
                        html: data.shape.js
                        scroll: true
                      )
                    )
                  )
                )
              )
            )
          )
          TextLink(
            .config(
              label: 'The language, step by step'
              href: '/docs/syntax'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'One design, every screen.'
              sub: 'Numbers are design pixels from your frames. Values flow between frames and structure steps at them. You write no media queries.'
            )
          )
          If(
            .cnd(data != null)
            .obj(Frames(.props(code: data.demo.code)))
          )
          TextLink(
            .config(
              label: 'How Design Scale works'
              href: '/docs/design-scale'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Change anything from anywhere, in order.'
              sub: 'Extract reads a feature, Inject layers a change at an exeOrder, and !mut protects what must never change. Tick the layers, or untick !mut.'
            )
          )
          If(
            .cnd(data != null)
            .obj(
              Row(
                .config(
                  w: fill
                  gap: 20
                  yAlign: stretch
                )
                Pane(
                  .config(
                    title: 'store.layr'
                    play: data.eeiPlay
                  )
                  Code(
                    .props(
                      html: data.eei
                      fit: true
                    )
                  )
                )
                Pane(
                  .config(
                    title: 'Store.card'
                    note: 'live'
                  )
                  Column(
                    .config(
                      w: fill
                      h: fill
                      minH: 220
                      className: 'lit-stage'
                      padding: all(28)
                      xAlign: mid
                      yAlign: mid
                    )
                    Container(
                      .id(card)
                      .config(
                        w: 260
                        !mut color: panel
                        cornerRadius: 12
                        padding: all(16)
                        shadow: shadow(y: 8, blur: 24, color: black.alpha(18%))
                        .border(
                          color: line
                          width: 1
                        )
                      )
                      .obj(
                        Column(
                          .config(
                            w: fill
                            gap: 4
                          )
                          Text(
                            .config(
                              size: 15
                              weight: semibold
                            )
                            .obj('Order 1042')
                          )
                          Text(
                            .config(
                              size: 13
                              color: muted
                            )
                            .obj('Two items, ships Monday')
                          )
                        )
                      )
                    )
                  )
                  Cascade()
                )
              )
            )
          )
          TextLink(
            .config(
              label: 'Export, Extract and Inject'
              href: '/docs/export-extract-inject'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Mistakes explained before they ship.'
              sub: 'Every problem has a code, an explanation and a fix. The same checks run in your editor, in the CLI and in CI.'
            )
          )
          If(
            .cnd(data != null)
            .obj(
              Row(
                .config(
                  w: fill
                  gap: 20
                  yAlign: stretch
                )
                Pane(
                  .config(title: 'checkout.layr')
                  Code(.props(html: data.mistakes.source))
                )
                Pane(
                  .config(
                    title: 'layr analyze'
                    note: '${data.mistakes.count} errors'
                  )
                  Console(.props(text: data.mistakes.report))
                )
              )
            )
          )
          TextLink(
            .config(
              label: 'Every diagnostic'
              href: '/errors'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Your React packages keep working.'
              sub: 'Import a React component and use it as a node; hooks run in a .react block. LAYR components work inside React apps too.'
            )
          )
          If(
            .cnd(data != null)
            .obj(
              Pane(
                .config(title: 'stats.layr')
                Code(.props(html: data.react))
              )
            )
          )
          TextLink(
            .config(
              label: 'React interop'
              href: '/docs/react'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Learn it and write it with any AI.'
              sub: 'LAYR ships its own rules for AI: agents write canonical LAYR and check it with the same tools you use, and any assistant can teach it to you from the docs.'
            )
          )
          AiPanel()
          TextLink(
            .config(
              label: 'AI agents: the Skill and MCP'
              href: '/docs/ai'
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Write it in VS Code.'
              sub: 'Completion that writes whole calls, wrap and extract refactors, format on save, and diagnostics with fixes, from the same compiler as the CLI.'
            )
          )
          Wrap(
            .config(
              gap: 12
              runGap: 12
              yAlign: mid
            )
            PrimaryLink(
              .config(
                label: 'Download for VS Code'
                href: '/download/layr-vscode.vsix'
                icon: 'download'
                download: true
              )
            )
            TextLink(
              .config(
                label: 'Install and features'
                href: '/editor'
              )
            )
          )
        )

        Band(
          SectionHead(
            .config(
              title: 'Addons from the Library.'
              sub: 'Official addons ship as LAYR source you can read and eject. Anyone can publish one to npm and list it.'
            )
          )
          If(
            .cnd(data != null)
            .obj(
              Pane(
                Each(
                  .of(data.addons)
                  .as(a)
                  .obj(
                    AddonRow(
                      .config(
                        id: a.id
                        npm: a.npm
                        description: a.description
                        version: a.version
                      )
                    )
                  )
                )
              )
            )
          )
          TextLink(
            .config(
              label: 'Browse the Library'
              href: '/library'
            )
          )
        )

        Column(
          .config(
            w: fill
            padding: sym(x: 32)
            xAlign: mid
          )
          Column(
            .config(
              w: fill
              maxW: 1240
            )
            Ad(
              .props(
                placement: 'home'
                height: 250
              )
            )
          )
        )

        Band(
          Column(
            .config(
              w: fill
              gap: 20
              padding: sym(y: 24)
              xAlign: mid
            )
            Text(
              .config(
                size: 48
                align: mid
                letterSpacing: -1.5
                type: h2
                weight: 650
              )
              .at(
                m
                size: 30
              )
              .obj('Start in the browser. Keep it in your repo.')
            )
            Text(
              .config(
                size: 17
                maxW: 560
                align: mid
                color: muted
              )
              .obj(
                'The playground runs the real compiler. When you are ready, one command makes a project.'
              )
            )
            Wrap(
              .config(
                gap: 12
                runGap: 12
                xAlign: mid
                yAlign: mid
              )
              PrimaryLink(
                .config(
                  label: 'Try it in the browser'
                  href: '/playground'
                  icon: 'play'
                )
              )
              Command(.props(command: 'npx @dynshift/layr create my-app'))
            )
          )
        )
      )
    )
    .footer(SiteFooter())
  )
)
