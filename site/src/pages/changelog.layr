import { TopBar } from '../widgets/shell.layr'
import { MdPage } from '../widgets/mdpage.layr'
import { loadPage } from '../lib/content.ts'

Page(
  .name(ChangelogPage)
  .route('/changelog')
  .meta(
    title: '${data.title} · LAYR'
    description: data.description
  )
  .load { return loadPage('changelog') }
  Scaffold(
    .config(color: canvas)
    .bar(TopBar())
    .body(MdPage(.config(page: data)))
  )
)
