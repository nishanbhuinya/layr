import { TopBar } from '../../widgets/shell.layr'
import { MdPage } from '../../widgets/mdpage.layr'
import { loadPage } from '../../lib/content.ts'

Page(
  .name(PublishPage)
  .route('/library/publish')
  .meta(title: '${data.title} · LAYR', description: data.description)
  .load { return loadPage('publish') }
  Scaffold(.config(color: canvas) .bar(TopBar()) .body(MdPage(.config(page: data))))
)
