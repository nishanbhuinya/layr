Page(
  .name(Store)
  .route('/')
  Scaffold(.body(Container(
    .id(card)
    .config(
      w: 260
      cornerRadius: 12
      padding: all(16)
      !mut color: panel
      .border(color: line, width: 1)
    )
    .obj(Column(
      .config(gap: 4)
      Text(.config(size: 15, weight: semibold) .obj('Order 1042'))
      Text(.config(size: 13, color: muted) .obj('Two items, ships Monday'))
    ))
  )))
)

Extract(.from(Store.card) .exeOrder(-1) insets base = card.padding)
Inject(.into(Store.card) .exeOrder(0) card.padding = base * 2)
Inject(.into(Store.card) .exeOrder(1) card.padding = card.padding + all(4))
