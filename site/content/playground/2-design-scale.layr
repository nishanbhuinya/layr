// One design, every frame: 48 at m flows to 96 at w. Resize the preview or pick a frame.
Page(
  .name(Scale)
  .route('/')
  Scaffold(
    .config(color: canvas)
    .body(Mid(Column(
      .config(gap: 12, xAlign: mid, padding: all(24))
      Text(
        .config(size: 48, weight: bold, color: ink)
        .at(w, size: 96)
        .obj('Numbers flow')
      )
      Text(.config(size: 16, color: muted) .obj('Structure steps at the frames: the dots appear from t.'))
      Row(
        .config(gap: 8)
        .at(m, hide: true)
        .at(t, hide: false)
        Container(.config(size: 40, color: ember, cornerRadius: 8))
        Container(.config(size: 40, color: gold, cornerRadius: 8))
        Container(.config(size: 40, color: teal, cornerRadius: 8))
        Container(.config(size: 40, color: violet, cornerRadius: 8))
      )
    )))
  )
)
