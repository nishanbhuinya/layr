// Chips wrap, state drives the view, and every click is one line of TypeScript.
Page(
  .name(Picker)
  .route('/')

  var txt picked = 'Layout'
  const list<txt> topics = ['Layout', 'Design Scale', 'State', 'Animation', 'Export', 'Extract', 'Inject']

  Scaffold(
    .config(color: canvas)
    .body(Column(
      .config(w: fill, padding: all(24), gap: 16)
      Text(.config(type: h2, size: 24, color: ink) .obj('Pick a topic'))
      Wrap(
        .config(gap: 8)
        Each(
          .of(topics)
          .as(t)
          .obj(Button(
            .config(padding: sym(x: 14, y: 8), cornerRadius: 999, color: picked == t ? accent : panel, .border(color: picked == t ? accent : line, width: 1))
            .fnc { picked = t }
            .obj(Text(.config(color: picked == t ? onAccent : ink, weight: medium) .obj(t)))
          ))
        )
      )
      Text(.config(color: muted) .obj('You picked $picked.'))
    ))
  )
)
